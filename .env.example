# Ollama LLM Configuration
OLLAMA_CLOUD_HOST=https://ollama.com/api
OLLAMA_API_KEY=your-api-key-here

# Logging Configuration
# Set the logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=DEBUG

# Log output format: plain (human-readable) or json (machine-parseable)
LOG_FORMAT=plain

# Log directory path (relative or absolute)
LOG_DIRECTORY=logs

# Environment: dev, prod, or debug
# dev/debug: logs appear in both file and console
# prod: logs only in files
ENVIRONMENT=dev
